# Writes OUTPUT, a C++ source that defines the bytes of INPUT (the compiled
# eBPF object) as kNetreplayBpf and their number as kNetreplayBpfSize, so
# that tuushin-netreplay carries its program and needs no file beside it.
#   cmake -DINPUT=netreplay.bpf.o -DOUTPUT=netreplay_bpf.cpp -P embed.cmake
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){16})" "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}"
  "// Generated by tools/netreplay/embed.cmake from netreplay.bpf.o.\n"
  "#include <cstddef>\n"
  "// libbpf reads the ELF in place.\n"
  "alignas(8) extern const unsigned char kNetreplayBpf[] = {\n${bytes}};\n"
  "extern const std::size_t kNetreplayBpfSize = ${size};\n")
