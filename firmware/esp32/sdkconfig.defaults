# The host link owns the serial port: no console, and no logs from the
# bootloader or the app on it. (The ROM still prints a few lines at reset;
# the host's frame reader skips them.)
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
